#!/usr/bin/env python3
"""Owner-local tool for the paired iPhone. Never equate queued with completed."""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from plugins.cloudseed_mobile.iphone_reminders import ReminderError, ReminderOutbox


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--state-dir', type=Path, required=True, help='Retained integration state directory (Hermes root/webui)')
    parser.add_argument('--profile', required=True)
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('devices')
    request = sub.add_parser('request')
    request.add_argument('--device', required=True)
    request.add_argument('--id', required=True, help='Stable UUID; reuse for retries of the same request')
    request.add_argument('--operation', choices=['create', 'list', 'complete'], required=True)
    request.add_argument('--json-file', type=Path, required=True, help='JSON object; keep personal content out of argv')
    status = sub.add_parser('status')
    status.add_argument('--device', required=True)
    status.add_argument('--id', required=True)
    args = parser.parse_args()
    path = args.state_dir / 'iphone-reminders' / 'outbox.sqlite3'
    if not path.is_file():
        parser.error('Connect Reminders in Hermex first')
    store = ReminderOutbox(path)
    try:
        if args.command == 'devices':
            result = {'devices': store.devices(args.profile)}
        elif args.command == 'request':
            with args.json_file.open('rb') as source:
                payload = source.read(20001)
            if len(payload) > 20000:
                raise ReminderError('Request file too large')
            result = store.enqueue(args.device, args.id, args.operation, json.loads(payload), args.profile)
        else:
            result = store.status(args.device, args.id, args.profile)
        print(json.dumps(result))
    except (ReminderError, OSError, ValueError) as error:
        # No raw content, paths or credentials in diagnostics.
        print(json.dumps({'error': 'Reminder request rejected', 'type': type(error).__name__}))
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
