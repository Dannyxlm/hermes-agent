{
  "contract": "cloudseed-machines",
  "protocol_version": 1,
  "feature_versions": {"machines": 1},
  "semantics": {
    "machine_order": ["ava-box", "mac-mini", "macbook-air"],
    "status_values": ["online", "stale", "unreachable", "unknown"],
    "writer_status_rule": "unknown = never provisioned or never attempted; online = latest attempt succeeded; unreachable = latest attempt failed, last-good values and last_sample_at kept (null when never sampled); stale is reader-derived and readers must also accept it from the file",
    "stale_after_seconds": 180,
    "reader_stale_rule": "when evaluate_at - generated_at > stale_after_seconds every machine displays stale with its age; when an online machine's last_sample_at is more than stale_after_seconds older than generated_at it displays stale",
    "null_means": "unknown; render as a dash, never as zero",
    "cpu_percent": "percent of all cores, 0 to 100, one decimal. macOS: 100 - idle% from the second sample of top -l 2 -s 1 header line. Linux: 100 * (delta_total - delta_idle - delta_iowait) / delta_total from /proc/stat; null when delta_total <= 0 or the counters reset",
    "memory_pressure_macos": "kern.memorystatus_vm_pressure_level 1 = normal, 2 = warn, 4 = critical, anything else = null",
    "memory_pressure_linux": "ratio = MemAvailable / MemTotal; ratio < 0.05 = critical, ratio < 0.15 = warn, otherwise normal; null when either field is missing or MemTotal is 0",
    "disk": "data volume: macOS /System/Volumes/Data, Linux /. free_gb and total_gb in GiB with one decimal, used_percent 0 to 100 with one decimal",
    "process_names": "never collected or written; a writer drops any field named top, processes or process",
    "timestamps": "ISO 8601 UTC, second precision, Z suffix"
  },
