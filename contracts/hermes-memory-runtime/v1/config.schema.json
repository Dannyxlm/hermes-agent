{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudseed.co/contracts/hermes-memory-runtime/v1/config.schema.json",
  "title": "Hermes Memory V3 Runtime Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_mode",
    "subject_id",
    "allowed_origins",
    "subject_bindings_digest",
    "provider"
  ],
  "properties": {
    "schema_version": {"const": "hermes-memory-v3-config/v1"},
    "deployment_mode": {"const": "tools_only_read_containment"},
    "subject_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "telegram_private",
          "telegram_personal_group",
          "cli",
          "tui",
          "photon_api",
          "desktop_websocket"
        ]
      }
    },
    "subject_bindings_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "limits"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        },
        "target": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "allOf": [
              {"pattern": "^[a-z][a-z0-9_]{0,79}$"},
              {
                "not": {
                  "pattern": "(api_?key|token|secret|password|credential|private_?key)"
                }
              }
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deadline_seconds",
            "max_provider_calls",
            "max_items",
            "max_chars"
          ],
          "properties": {
            "deadline_seconds": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 5.0
            },
            "max_provider_calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "max_items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "max_chars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8000
            }
          }
        }
      }
    }
  }
}
