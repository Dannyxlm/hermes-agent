+    }
+  }
+
+  text = text.replace(/^\/+|\/+$/g, "").replace(/\.git$/i, "")
+  return /^[0-9A-Za-z_.-]+\/[0-9A-Za-z_.-]+$/.test(text) ? text : null
+}
